# --- Compte Hostinger (hPanel > Emails > Gérer > Connecter applications et appareils) ---
MAIL_USER=toi@tondomaine.fr
MAIL_PASSWORD=change-me
IMAP_HOST=imap.hostinger.com
IMAP_PORT=993
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
FROM_NAME=Ton Nom

# Noms exacts visibles via l'outil list_folders
SENT_FOLDER=INBOX.Sent
DRAFTS_FOLDER=INBOX.Drafts

# --- Sécurité du serveur MCP ---
# Génère avec : python -c "import secrets; print(secrets.token_urlsafe(32))"
MCP_AUTH_TOKEN=change-me-long-random-token

# --- Garde-fous d'envoi ---
ALLOW_SEND=true
# Liste blanche (adresses ou domaines précédés de @). Vide = tout autorisé (déconseillé)
ALLOWED_RECIPIENTS=
MAX_RECIPIENTS=5
MAX_SENDS_PER_HOUR=10
MAX_BODY_CHARS=8000

# --- Réseau ---
HOST=0.0.0.0
PORT=8000
